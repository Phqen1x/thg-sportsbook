# Required
BOT_TOKEN=your_discord_bot_token_here

# Optional — role ID for admin commands (falls back to server administrator permission)
ADMIN_ROLE_ID=

# Optional — channel ID where /admin settings announce posts
ANNOUNCEMENT_CHANNEL_ID=

# Optional — channel ID where /withdraw and /deposit requests are posted for admins
WITHDRAW_CHANNEL_ID=

# Optional — guild ID for instant slash command sync during development
# Remove or leave blank for global sync (takes up to 1 hour to propagate)
DEV_GUILD_ID=

# Economy defaults
DEFAULT_CHIPS=1000

# Cashout defaults (admins can override per game/market)
CASHOUT_ALLOWED=false
CASHOUT_RATE=0.65
