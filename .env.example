# Required
BOT_TOKEN=your_discord_bot_token_here

# Optional — role ID for admin commands (falls back to server administrator permission)
ADMIN_ROLE_ID=

# Optional — channel ID where /admin settings announce posts
ANNOUNCEMENT_CHANNEL_ID=

# Optional — channel ID where /withdraw and /deposit requests are posted for admins
WITHDRAW_CHANNEL_ID=

# Optional — guild ID for instant slash command sync during development
# Remove or leave blank for global sync (takes up to 1 hour to propagate)
DEV_GUILD_ID=

# Economy defaults
DEFAULT_CHIPS=1000

# Cashout defaults (admins can override per game/market)
CASHOUT_ALLOWED=false
CASHOUT_RATE=0.65

# ── Web Dashboard ────────────────────────────────────────────────────────────
# Discord OAuth2 application credentials (create at discord.com/developers)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The public base URL of the web dashboard (no trailing slash)
# Add <WEB_BASE_URL>/auth/callback as a redirect URI in your Discord app
WEB_BASE_URL=http://localhost:8000

# Secret key for signing session cookies — change this in production
WEB_SECRET_KEY=change-me-in-production

# The Discord guild (server) ID — used to check admin role membership at login
GUILD_ID=

# Web server bind address and port
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ── Discord Activity (embedded in-Discord UI) ────────────────────────────────
# The Activity is served by this same web app and reuses the variables above:
#   DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET  — server-side OAuth code exchange
#   BOT_TOKEN + GUILD_ID + ADMIN_ROLE_ID       — server-side admin verification
#   WEB_SECRET_KEY                             — signs the activity bearer token
#   WEB_BASE_URL                               — used by /play's "Open in browser" link
# No additional variables are required. See ACTIVITY_SETUP.md for the Discord
# Developer Portal config (enable Activities + add the "/" URL mapping).
