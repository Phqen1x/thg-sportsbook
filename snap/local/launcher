#!/bin/sh
mkdir -p "$SNAP_COMMON/data"

if [ ! -f "$SNAP_COMMON/.env" ]; then
    echo "ERROR: $SNAP_COMMON/.env not found." >&2
    echo "Create it with at minimum: BOT_TOKEN=your_discord_bot_token" >&2
    echo "Then run: sudo snap restart thg-sportsbook" >&2
    exit 1
fi

# Anchor the (writable) data directory. The bot is fully multi-guild and names
# its own per-server files sportsbook_<guild_id>.db here; the filename below is
# only used to locate the directory.
export DB_PATH="${DB_PATH:-$SNAP_COMMON/data/sportsbook.db}"

cd "$SNAP_COMMON"
exec "$SNAP/bin/thg-sportsbook"
