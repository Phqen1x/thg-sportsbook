#!/bin/sh
mkdir -p "$SNAP_COMMON/data"

if [ ! -f "$SNAP_COMMON/.env" ]; then
    echo "ERROR: $SNAP_COMMON/.env not found." >&2
    echo "Create it with at minimum: BOT_TOKEN=your_discord_bot_token" >&2
    echo "Then run: sudo snap restart thg-sportsbook.web" >&2
    exit 1
fi

if [ -z "$DB_PATH" ]; then
    GUILD_ID=$(grep '^GUILD_ID=' "$SNAP_COMMON/.env" | cut -d= -f2- | tr -d '[:space:]')
    if [ -n "$GUILD_ID" ]; then
        export DB_PATH="$SNAP_COMMON/data/sportsbook_${GUILD_ID}.db"
    else
        export DB_PATH="$SNAP_COMMON/data/sportsbook.db"
    fi
fi

cd "$SNAP_COMMON"
exec "$SNAP/bin/thg-sportsbook-web"
